<div class="profile-image">
    <img src="images/profile.jpg" alt="J. Moseh Wesly">
</div>
.profile-image {
    width: 320px;
    height: 420px;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    border: 5px solid #ffffff;
    transition: 0.4s ease;
}

.profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.profile-image:hover {
    transform: scale(1.05);
    box-shadow: 0 15px 40px rgba(0,0,0,0.4);
}
